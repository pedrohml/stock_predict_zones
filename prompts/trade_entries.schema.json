{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade_entries.schema.json",
  "title": "Ranked trade setups",
  "description": "Reply to prompts/trade_entries.md: up to three trade setups derived from one reversal-zones input and projection, ranked by edge per order. A failed precondition is reported as {task, error} instead.",
  "oneOf": [{ "$ref": "#/$defs/result" }, { "$ref": "#/$defs/failure" }],

  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "asset", "as_of", "valid_until", "probability", "units", "entries", "confidence", "method", "note"],
      "properties": {
        "task": { "const": "trade_entries" },
        "asset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ticker", "currency"],
          "properties": {
            "ticker": { "type": "string", "minLength": 1 },
            "currency": { "type": "string", "minLength": 1 }
          }
        },
        "as_of": {
          "type": "object",
          "additionalProperties": false,
          "required": ["time", "price"],
          "properties": {
            "time": { "type": "string", "description": "The projection's as_of.time, ISO 8601 with offset." },
            "price": { "$ref": "#/$defs/price" }
          }
        },
        "valid_until": { "type": "string", "format": "date", "description": "The projection's horizon.last. The setups mean nothing after it." },
        "probability": { "enum": ["close_in_zone", "touched_once"], "description": "What the projection's probabilities measure." },
        "units": {
          "type": "object",
          "additionalProperties": false,
          "required": ["move", "buffer", "range"],
          "properties": {
            "move": { "$ref": "#/$defs/distance", "description": "One candle's typical move: price x volatility.assumed[0]." },
            "buffer": { "$ref": "#/$defs/distance", "description": "Gap between a stop and its zone edge: 0.25 x move." },
            "range": { "$ref": "#/$defs/distance", "description": "Typical distance travelled by the end of the horizon." }
          }
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/entry" },
          "description": "Best first. Fewer than three only when fewer are valid."
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "limits"],
          "properties": {
            "level": { "enum": ["low", "medium"], "description": "Never higher than the projection's." },
            "limits": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "method": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1, "description": "States that the setups are hypothetical and not a recommendation." }
      }
    },

    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "error"],
      "properties": {
        "task": { "const": "trade_entries" },
        "error": { "type": "string", "minLength": 1 }
      }
    },

    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "id", "side", "setup", "entry", "stop", "target", "payoff", "odds", "edge", "quality", "why", "watch"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
        "id": { "type": "string", "pattern": "^(long|short)-[SR][0-9]+-(reversal|continuation)$", "description": "side, zone id, setup." },
        "side": { "enum": ["long", "short"] },
        "setup": { "enum": ["reversal", "continuation"] },
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["order", "price", "anchor"],
          "properties": {
            "order": { "enum": ["limit", "stop", "market"] },
            "price": { "$ref": "#/$defs/price" },
            "anchor": { "$ref": "#/$defs/anchor" }
          }
        },
        "stop": { "$ref": "#/$defs/level" },
        "target": { "$ref": "#/$defs/level" },
        "payoff": {
          "type": "object",
          "additionalProperties": false,
          "required": ["risk", "reward", "ratio"],
          "properties": {
            "risk": { "$ref": "#/$defs/distance", "description": "|entry - stop|." },
            "reward": { "$ref": "#/$defs/distance", "description": "|target - entry|." },
            "ratio": { "type": "number", "minimum": 0.5, "description": "reward / risk." }
          }
        },
        "odds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fill", "win_if_filled", "basis"],
          "properties": {
            "fill": { "$ref": "#/$defs/probability", "description": "Chance the entry order fills within the horizon." },
            "win_if_filled": { "$ref": "#/$defs/probability", "description": "Ceiling on the chance the target is reached once filled." },
            "basis": { "type": "string", "minLength": 1, "description": "The projection numbers and the formula behind both odds." }
          }
        },
        "edge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["if_filled", "per_order"],
          "properties": {
            "if_filled": { "type": "number", "description": "Expected result in units of risk once filled." },
            "per_order": { "type": "number", "description": "fill x if_filled. The ranking key." }
          }
        },
        "quality": { "enum": ["favourable", "marginal", "unfavourable"] },
        "why": { "type": "string", "minLength": 1 },
        "watch": { "type": "array", "items": { "type": "string" }, "description": "Zones in the way and events that can hurt the setup. May be empty." }
      }
    },

    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["price", "anchor"],
      "properties": {
        "price": { "$ref": "#/$defs/price" },
        "anchor": { "$ref": "#/$defs/anchor" }
      }
    },
    "anchor": { "type": "string", "minLength": 1, "description": "The zone edge the price comes from, with the buffer when one is applied." },
    "price": { "type": "number", "exclusiveMinimum": 0 },
    "distance": { "type": "number", "exclusiveMinimum": 0 },
    "probability": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
